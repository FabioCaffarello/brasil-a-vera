# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# drizzle
/drizzle

# biome
.biome/

# OS
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# cloudflare (opennextjs adapter)
/.open-next/
/.wrangler/

# vercel (não usamos, mas guarda contra `vercel link` acidental)
/.vercel/

# repos externos clonados localmente para consulta arquitetural / inspiração
# (ex: protótipo do designer, referência de stack). Nunca devem entrar no
# grafo de tipos (tsconfig.exclude), no lint (biome.json) ou no histórico.
/reference/

# claude code — versionamento parcial (Wave 5 Sprint 5.0)
# O ecossistema .claude/ é versionado como infraestrutura de time
# (settings.json, agents/, skills/, hooks/, docs/, README.md).
# Apenas estado verdadeiramente local fica ignorado abaixo.
/.claude/settings.local.json
/.claude/transcripts/
/.claude/cache/
/.claude/telemetry/
/.claude/.role-log

# typescript
*.tsbuildinfo

# zip
*.zip
# temporary work files (gh issue bodies, drafts, etc.)
.tmp/

# dotcontext runtime state
.context/plans/
.context/cache/semantic/
.context/runtime/
.context/**/archive/

