{
  "name": "brasil-a-vera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci": "biome ci .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "ingest:deputados": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/camara/sync-deputados.ts",
    "ingest:deputados:detalhes": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/camara/sync-deputados-detalhes.ts",
    "ingest:votacoes:camara": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/camara/sync-votacoes.ts",
    "ingest:despesas:camara": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/camara/sync-despesas.ts",
    "ingest:senadores": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/senado/sync-senadores.ts",
    "ingest:senadores:detalhes": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/senado/sync-senadores-detalhes.ts",
    "ingest:votacoes:senado": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/senado/sync-votacoes-senado.ts",
    "ingest:proposicoes:camara": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/camara/sync-proposicoes.ts",
    "ingest:materias:senado": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/senado/sync-materias.ts",
    "reconcile:parlamentares": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/reconciliation/reconcile-parlamentares.ts",
    "reconcile:votacoes": "tsx --tsconfig tsconfig.json --import ./ingestion/shared/env.ts ingestion/reconciliation/reconcile-votacoes.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "next": "16.2.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
