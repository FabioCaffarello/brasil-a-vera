    "ingest:camara:votacoes": "tsx --tsconfig tsconfig.ingestion.json ingestion/camara/votacoes.ts",
    "ingest:camara:proposicoes": "tsx --tsconfig tsconfig.ingestion.json ingestion/camara/proposicoes.ts",
    "ingest:camara:tramitacao": "tsx --tsconfig tsconfig.ingestion.json ingestion/camara/tramitacao.ts",
