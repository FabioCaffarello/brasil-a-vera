    "ingest:camara:relatorias": "tsx --tsconfig tsconfig.ingestion.json ingestion/camara/relatorias.ts",
    "ingest:senado:relatorias": "tsx --tsconfig tsconfig.ingestion.json ingestion/senado/relatorias.ts",
    "ingest:camara:liderancas": "tsx --tsconfig tsconfig.ingestion.json ingestion/camara/liderancas.ts",
    "ingest:senado:liderancas": "tsx --tsconfig tsconfig.ingestion.json ingestion/senado/liderancas.ts",
