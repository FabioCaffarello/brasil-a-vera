{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasil-a-vera",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // Secrets esperados (configurar one-time via `wrangler secret put`):
  //   DATABASE_URL   — Neon pooled connection (app em runtime)
  //   DIRECT_URL     — Neon direct connection (migrations; opcional em runtime)
  //
  // Cache R2 (incremental cache do OpenNext) ainda não é necessário: todas as
  // rotas são dinâmicas (ƒ). Revisitar quando entrar ISR/Cache Components.
  // Ver https://opennext.js.org/cloudflare/caching
}
