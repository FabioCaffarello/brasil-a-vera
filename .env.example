# =============================================================================
# Brasil a Vera - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Neon Postgres  (https://neon.tech)
# -----------------------------------------------------------------------------
# 1) Crie um projeto em neon.tech
# 2) Em "Connection Details", copie a "Pooled connection" para DATABASE_URL
#    (usada pela aplicação Next.js em runtime — suporta múltiplas conexões)
# 3) Copie a "Direct connection" para DIRECT_URL
#    (usada pelo Drizzle Kit para gerar e aplicar migrations)

DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Cloudflare  (https://dash.cloudflare.com/profile/api-tokens)
# -----------------------------------------------------------------------------
# Necessários apenas para deploy local manual (`npm run cf:deploy`).
# No CI, são configurados como GitHub Secrets:
#   Settings → Secrets and variables → Actions

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
# NODE_ENV NÃO deve ser definido aqui. O Next.js gerencia automaticamente:
#   next dev   → NODE_ENV=development
#   next build → NODE_ENV=production
#   vitest     → NODE_ENV=test
# Forçar NODE_ENV=development quebra o prerender em `next build` (Next 16).

# -----------------------------------------------------------------------------
# Wave 2+ — API Keys (Portal da Transparência)
# -----------------------------------------------------------------------------

# TRANSPARENCIA_API_KEY=

# -----------------------------------------------------------------------------
# Wave 2.0 — Admin endpoints (/api/stats)
# -----------------------------------------------------------------------------
# Chave para proteger endpoints admin (header `x-admin-key`). Mínimo 32 chars.
# Gerar com: openssl rand -base64 48
# Em prod (Cloudflare Workers), configurar via `wrangler secret put ADMIN_API_KEY`.

# ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Wave 4.1 — Clerk authentication (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
# Crie uma "Application" no Clerk Dashboard em dev mode e copie:
#   API Keys → Publishable key (NEXT_PUBLIC_*)
#   API Keys → Secret keys → Secret key
#
# Em Cloudflare Workers, configurar Workers Secrets via Wrangler:
#   wrangler secret put NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   wrangler secret put CLERK_SECRET_KEY
#
# Para `npm run cf:preview` localmente, copiar para .dev.vars também
# (Wrangler usa .dev.vars; Next dev usa .env.local).
#
# Setup detalhado: docs/contributing/CLERK-SETUP.md
# Governança: docs/architecture/ADR/022-clerk-para-autenticacao.md

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# -----------------------------------------------------------------------------
# Wave 10 Etapa 7 — Cron de alertas semanais
# -----------------------------------------------------------------------------
# Secret compartilhado entre o trigger (GitHub Actions workflow
# `.github/workflows/alertas-cron.yml`) e o endpoint
# `POST /api/cron/alertas/run`. Validado via header `x-cron-secret`.
#
# Gerar: openssl rand -hex 32
#
# Configurar em:
#   - .env.local (dev local)
#   - .dev.vars (Wrangler preview, opcional)
#   - GitHub Secrets (workflow leva via `secrets.CRON_SECRET`)
#   - Workers Secret: `wrangler secret put CRON_SECRET` (produção)
#
# Setup detalhado: docs/contributing/CRON-ALERTAS-SETUP.md

# CRON_SECRET=...

# -----------------------------------------------------------------------------
# Wave 10 Etapa 7.3 — Resend (envio do email do report semanal)
# -----------------------------------------------------------------------------
# 1) Criar conta em https://resend.com e adicionar domínio
# `brasilavera.org`
# 2) Verificar DNS (DKIM/SPF/DMARC) seguindo o wizard
# 3) Gerar API key em "API Keys" — usar `re_...` (não a key de teste)
# 4) Configurar:
#    - RESEND_API_KEY=re_...
#    - RESEND_FROM="Brasil à Vera <alertas@brasilavera.org>"
#
# Configurar em .env.local, .dev.vars, GitHub Secrets, e Workers Secret
# (bootstrap automático via deploy.yml).
#
# Setup detalhado: docs/contributing/CRON-ALERTAS-SETUP.md

# RESEND_API_KEY=re_...
# RESEND_FROM="Brasil à Vera <alertas@brasilavera.org>"

# -----------------------------------------------------------------------------
# Wave 3+ — Microserviços Go (quando extraídos do monolito)
# -----------------------------------------------------------------------------

# INGESTION_SERVICE_URL=http://localhost:8080
# SCORING_SERVICE_URL=http://localhost:8081
