# =============================================================================
# Brasil a Vera - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL / Neon / Supabase)
# -----------------------------------------------------------------------------

# URL de conexão com pooling (usada pela aplicação Next.js em runtime)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL de conexão direta, sem pooling (usada pelo Drizzle para migrations)
# No Supabase/Neon, essa URL é diferente da pooled
DIRECT_URL=postgresql://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Wave 2+ — API Keys (Portal da Transparência)
# -----------------------------------------------------------------------------

# TRANSPARENCIA_API_KEY=

# -----------------------------------------------------------------------------
# Wave 3+ — Microserviços Go (quando extraídos do monolito)
# -----------------------------------------------------------------------------

# INGESTION_SERVICE_URL=http://localhost:8080
# SCORING_SERVICE_URL=http://localhost:8081
