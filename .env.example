# =============================================================================
# Brasil a Vera - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Neon Postgres  (https://neon.tech)
# -----------------------------------------------------------------------------
# 1) Crie um projeto em neon.tech
# 2) Em "Connection Details", copie a "Pooled connection" para DATABASE_URL
#    (usada pela aplicação Next.js em runtime — suporta múltiplas conexões)
# 3) Copie a "Direct connection" para DIRECT_URL
#    (usada pelo Drizzle Kit para gerar e aplicar migrations)

DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Cloudflare  (https://dash.cloudflare.com/profile/api-tokens)
# -----------------------------------------------------------------------------
# Necessários apenas para deploy local manual (`npm run cf:deploy`).
# No CI, são configurados como GitHub Secrets:
#   Settings → Secrets and variables → Actions

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
# NODE_ENV NÃO deve ser definido aqui. O Next.js gerencia automaticamente:
#   next dev   → NODE_ENV=development
#   next build → NODE_ENV=production
#   vitest     → NODE_ENV=test
# Forçar NODE_ENV=development quebra o prerender em `next build` (Next 16).

# -----------------------------------------------------------------------------
# Wave 2+ — API Keys (Portal da Transparência)
# -----------------------------------------------------------------------------

# TRANSPARENCIA_API_KEY=

# -----------------------------------------------------------------------------
# Wave 3+ — Microserviços Go (quando extraídos do monolito)
# -----------------------------------------------------------------------------

# INGESTION_SERVICE_URL=http://localhost:8080
# SCORING_SERVICE_URL=http://localhost:8081
